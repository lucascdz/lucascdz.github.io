<?xml version="1.0" encoding="utf-8"?>
<rdf:RDF
  xmlns="https://lucascdz.github.io/ontology/lexipos#"
  xmlns:owl="http://www.w3.org/2002/07/owl#"
  xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
  xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
  xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
  xmlns:dct="http://purl.org/dc/terms/"
>


  <owl:Ontology rdf:about="https://lucascdz.github.io/ontology/lexipos">
    <rdfs:label xml:lang="en">Lexipos</rdfs:label>
    <dct:title xml:lang="en">Lexipos</dct:title>
    <dct:issued rdf:datatype="http://www.w3.org/2001/XMLSchema#date">2026-11-09</dct:issued>
    <owl:versionInfo>1.0</owl:versionInfo>
    <rdfs:comment xml:lang="en">A vocabulary of properties for expressing the position of notes within the entries of print dictionaries, for use with the OntoLex-Lemon and Lexicog models.</rdfs:comment>
    <dct:description xml:lang="en">Lexipos provides datatype properties for expressing the positions of textual notes within dictionary entries (for example, before or after the lemma, a definition, a form or a usage example). Each property is intended for use with a specific class from the OntoLex-Lemon or Lexicog models. Lexipos was designed to support the modelling of legacy print dictionaries as Linked Data and is inspired by Merrilees’ (1996) positional approach to dictionary entry components.</dct:description>
    <dct:license rdf:resource="https://creativecommons.org/licenses/by/4.0/"/>
    <dct:publisher rdf:resource="https://orcid.org/0000-0001-6798-7979">Lucas Consolin Dezotti</dct:publisher>
    <dct:creator rdf:resource="https://orcid.org/0000-0001-6798-7979">Lucas Consolin Dezotti</dct:creator>
  </owl:Ontology>

<!-- domain:LexicalEntry -->
  <owl:DatatypeProperty rdf:about="https://lucascdz.github.io/ontology/lexipos#preLemmaNote">
    <rdfs:label xml:lang="en">pre-lemma note</rdfs:label>
    <rdfs:comment xml:lang="en">A note attached to a lexical entry and printed before its lemma.</rdfs:comment>
    <rdfs:isDefinedBy rdf:resource="https://lucascdz.github.io/ontology/lexipos"/>
    <rdfs:domain rdf:resource="http://www.w3.org/ns/lemon/ontolex#LexicalEntry"/>
    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://lucascdz.github.io/ontology/lexipos#postLemmaNote">
    <rdfs:label xml:lang="en">post-lemma note</rdfs:label>
