    <rdfs:range rdf:resource="http://www.w3.org/2000/01/rdf-schema#Literal"/>
  </owl:DatatypeProperty>

  <owl:DatatypeProperty rdf:about="https://lucascdz.github.io/ontology/lexipos#preSenseNote">
    <rdfs:label xml:lang="en">pre-sense note</rdfs:label>
    <rdfs:comment xml:lang="en">A note attached to a lexical entry and printed before its senses.</rdfs:comment>
